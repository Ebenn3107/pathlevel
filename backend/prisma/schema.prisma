// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/* ── User ─────────────────────────────────────────────── */
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String
  avatarUrl String?
  xp        Int      @default(0)
  level     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  habits           Habit[]
  tasks            Task[]
  learningSessions LearningSession[]
  resources        Resource[]
  xpTransactions   XpTransaction[]
  completions        HabitCompletion[]
  userAchievements   UserAchievement[]

  @@map("users")
}

/* ── Habit ─────────────────────────────────────────────── */
model Habit {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String
  description String?
  frequency   String   @default("daily") // daily | weekly | monthly
  streak      Int      @default(0)
  bestStreak  Int      @default(0) @map("best_streak")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  completions HabitCompletion[]

  @@map("habits")
}

/* ── HabitCompletion ──────────────────────────────────── */
model HabitCompletion {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  habitId     String   @map("habit_id")
  periodKey   String   @map("period_key") // "2026-06-08" (daily), Monday date (weekly), "2026-06-01" (monthly)
  completedAt DateTime @default(now()) @map("completed_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, userId, periodKey])
  @@map("habit_completions")
}

/* ── Task ──────────────────────────────────────────────── */
model Task {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  title       String
  description String?
  priority    String    @default("medium") // low | medium | high
  completed   Boolean   @default(false)
  dueDate     DateTime? @map("due_date")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

/* ── LearningSession ──────────────────────────────────── */
model LearningSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  notes     String?
  duration  Int      // duration in minutes
  startedAt DateTime @map("started_at")
  endedAt   DateTime? @map("ended_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learning_sessions")
}

/* ── Resource ─────────────────────────────────────────── */
model Resource {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String
  url         String?
  description String?
  tags        String[] @default([])
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("resources")
}

/* ── XpTransaction ────────────────────────────────────── */
model XpTransaction {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  amount    Int      // positive = earned, negative = spent
  reason    String   // e.g. "habit_completed", "task_done", "session_finished"
  reference String?  // optional reference ID (e.g. habit ID, task ID)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reason, reference])
  @@map("xp_transactions")
}

/* ── Achievement ─────────────────────────────────── */
model Achievement {
  id          String   @id @default(uuid())
  code        String   @unique
  title       String
  description String
  icon        String
  createdAt   DateTime @default(now()) @map("created_at")

  userAchievements UserAchievement[]

  @@map("achievements")
}

/* ── UserAchievement ──────────────────────────────── */
model UserAchievement {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  achievementId String   @map("achievement_id")
  unlockedAt    DateTime @default(now()) @map("unlocked_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}
