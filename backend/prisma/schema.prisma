// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/* ── User ─────────────────────────────────────────────── */
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String
  avatarUrl String?
  xp        Int      @default(0)
  level     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  habits           Habit[]
  tasks            Task[]
  learningSessions LearningSession[]
  resources        Resource[]
  xpTransactions   XpTransaction[]
  completions        HabitCompletion[]
  userAchievements   UserAchievement[]
  learningGoals        LearningGoal[]
  learningUnits        LearningUnit[]
  resourceLearningUnits ResourceLearningUnit[]
  resourceLearningGoals ResourceLearningGoal[]
  learningSummaries      LearningSummary[]
  sessionResources       SessionResource[]

  @@map("users")
}

/* ── Habit ─────────────────────────────────────────────── */
model Habit {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String
  description String?
  frequency   String   @default("daily") // daily | weekly | monthly
  streak      Int      @default(0)
  bestStreak  Int      @default(0) @map("best_streak")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  completions HabitCompletion[]

  @@map("habits")
}

/* ── HabitCompletion ──────────────────────────────────── */
model HabitCompletion {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  habitId     String   @map("habit_id")
  periodKey   String   @map("period_key") // "2026-06-08" (daily), Monday date (weekly), "2026-06-01" (monthly)
  completedAt DateTime @default(now()) @map("completed_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, userId, periodKey])
  @@map("habit_completions")
}

/* ── Task ──────────────────────────────────────────────── */
model Task {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  title       String
  description String?
  priority    String    @default("medium") // low | medium | high
  completed   Boolean   @default(false)
  dueDate     DateTime? @map("due_date")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

/* ── LearningSession ──────────────────────────────────── */
model LearningSession {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  title           String
  // Deprecated legacy field — retained for compatibility; content is being
  // migrated into LearningSummary (Slice 4). See learning_summaries.
  notes           String?
  duration        Int       // duration in minutes
  startedAt       DateTime  @map("started_at")
  endedAt         DateTime? @map("ended_at")
  learningUnitId  String?   @map("learning_unit_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit LearningUnit? @relation(fields: [learningUnitId], references: [id], onDelete: SetNull)

  resources SessionResource[]
  summary  LearningSummary?

  @@map("learning_sessions")
}

/* ── Learning Summary ─────────────────────────────────── */
model LearningSummary {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  sessionId String   @unique @map("session_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  session LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("learning_summaries")
}

/* ── Session ↔ Resource (M:N junction) ───────────────── */
model SessionResource {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  resourceId String   @map("resource_id")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  session  LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  resource Resource        @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, resourceId])
  @@map("session_resources")
}

/* ── Library Status / Resource Progress enums ───────── */
enum ResourceLibraryStatus {
  INBOX
  SAVED
  ARCHIVED
}

enum ResourceProgress {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

/* ── Resource source-type (deterministic, non-AI) ─── */
enum ResourceSourceType {
  ARTICLE
  VIDEO
  DOCUMENT
  WEBSITE
  OTHER
}

/* ── Resource ─────────────────────────────────────────── */
model Resource {
  id            String                @id @default(uuid())
  userId        String                @map("user_id")
  title         String
  url           String?
  description   String?
  tags          String[]              @default([])
  libraryStatus ResourceLibraryStatus @default(INBOX) @map("library_status")
  progress      ResourceProgress      @default(NOT_STARTED)
  // Deterministic metadata enrichment (Micro-Slice B) — nullable, optional.
  thumbnailUrl  String?               @map("thumbnail_url")
  siteName      String?               @map("site_name")
  sourceType    ResourceSourceType?   @map("source_type")
  // Deprecated legacy field. Retained temporarily for API/frontend
  // compatibility (Slice 1C). Migrated value: completed = progress === COMPLETED.
  completed     Boolean               @default(false)
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  learningUnits ResourceLearningUnit[]
  learningGoals ResourceLearningGoal[]
  sessionResources SessionResource[]

  @@map("resources")
}

/* ── Learning Goal / Unit status enum ─────────────── */
enum LearningUnitStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  REOPENED
}

/* ── Learning Goal ─────────────────────────────────── */
model LearningGoal {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  title       String
  description String?
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  units     LearningUnit[]
  resources ResourceLearningGoal[]

  @@map("learning_goals")
}

/* ── Learning Unit ─────────────────────────────────── */
model LearningUnit {
  id          String            @id @default(uuid())
  goalId      String            @map("goal_id")
  userId      String            @map("user_id")
  title       String
  description String?
  status      LearningUnitStatus @default(NOT_STARTED)
  completedAt DateTime?         @map("completed_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  goal LearningGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  resources ResourceLearningUnit[]
  sessions  LearningSession[]

  @@map("learning_units")
}

/* ── Resource ↔ Learning Unit (M:N junction) ─────── */
model ResourceLearningUnit {
  id         String   @id @default(uuid())
  resourceId String   @map("resource_id")
  unitId     String   @map("unit_id")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  resource Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  unit     LearningUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceId, unitId])
  @@map("resource_learning_units")
}

/* ── Resource ↔ Learning Goal (M:N junction, unassigned) ── */
model ResourceLearningGoal {
  id         String        @id @default(uuid())
  resourceId String        @map("resource_id")
  goalId     String        @map("goal_id")
  userId     String        @map("user_id")
  createdAt  DateTime      @default(now()) @map("created_at")

  resource Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  goal     LearningGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceId, goalId])
  @@map("resource_learning_goals")
}

/* ── XpTransaction ────────────────────────────────────── */
model XpTransaction {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  amount    Int      // positive = earned, negative = spent
  reason    String   // e.g. "habit_completed", "task_done", "session_finished"
  reference String?  // optional reference ID (e.g. habit ID, task ID)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reason, reference])
  @@map("xp_transactions")
}

/* ── Achievement ─────────────────────────────────── */
model Achievement {
  id          String   @id @default(uuid())
  code        String   @unique
  title       String
  description String
  icon        String
  createdAt   DateTime @default(now()) @map("created_at")

  userAchievements UserAchievement[]

  @@map("achievements")
}

/* ── UserAchievement ──────────────────────────────── */
model UserAchievement {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  achievementId String   @map("achievement_id")
  unlockedAt    DateTime @default(now()) @map("unlocked_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}
