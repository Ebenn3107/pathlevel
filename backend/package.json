{
  "name": "@pathlevel/backend",
  "version": "1.0.0",
  "description": "PathLevel backend — Track Your Journey. Level Your Growth.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "clean": "rm -rf dist",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "npx tsx prisma/seed.ts",
    "test:achievements": "ts-node --files tests/achievements.test.ts",
    "test:xp": "ts-node --files tests/xp.test.ts",
    "test:atomicity": "ts-node --files tests/atomicity.test.ts",
    "test:resource": "ts-node --files tests/resource.test.ts",
    "test:learning": "ts-node --files tests/learning.test.ts",
    "test:sessions": "ts-node --files tests/sessions.test.ts",
    "test:search": "ts-node --files tests/search.test.ts",
    "test:metadata": "ts-node --files tests/metadata.test.ts",
    "test": "ts-node --files tests/achievements.test.ts && ts-node --files tests/xp.test.ts && ts-node --files tests/atomicity.test.ts && ts-node --files tests/resource.test.ts && ts-node --files tests/learning.test.ts && ts-node --files tests/sessions.test.ts && ts-node --files tests/search.test.ts && ts-node --files tests/metadata.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.15.0",
    "prisma": "^7.8.0",
    "tsx": "^4.19.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.2",
    "nodemon": "^3.1.14",
    "typescript": "^6.0.3"
  },
  "types": "./dist/server.d.ts",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
